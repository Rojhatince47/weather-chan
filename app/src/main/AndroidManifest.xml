<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Konum birinci liste: cihazın o anki konumunu okumak için.
         coarse, fine'ın ikisini de istiyoruz: kullanıcı yalnız yaklaşık
         konuma izin verse bile akış çalışsın. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Konum donanimı olmayan cihazlarda uygulama kurulabilir kalmalı;
         eksik donanımda konum okunamaz, liste boş duruma düşer. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".HavaApplication"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hava">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hava">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
