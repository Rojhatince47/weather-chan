<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Konum birinci liste: cihazın o anki konumunu okumak için.
         coarse, fine'ın ikisini de istiyoruz: kullanıcı yalnız yaklaşık
         konuma izin verse bile akış çalışsın. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 13+ bildirim izni; reddedilirse işçi sessizce susar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Konum donanimı olmayan cihazlarda uygulama kurulabilir kalmalı;
         eksik donanımda konum okunamaz, liste boş duruma düşer. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".HavaApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hava">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hava">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".feature.widget.presentation.WeatherChatWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_chat_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_chat_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.presentation.WeatherInfoWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_info_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_info_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.presentation.WeatherCharacterWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_character_only_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_character_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.presentation.WeatherTalkingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_talking_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_talking_widget_info" />
        </receiver>

        <!-- WorkManager, HiltWorkerFactory'yi kullanabilsin diye varsayılan
             başlatıcı kapatılır; uygulama Configuration.Provider uygular. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
